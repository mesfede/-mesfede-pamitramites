{
  "entities": {
    "Tramite": {
      "title": "Trámite",
      "description": "Información detallada sobre un trámite de PAMI.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string" },
        "categoria": { "type": "string" },
        "descripcion": { "type": "string" },
        "pasos": {
          "type": "array",
          "items": { "type": "string" }
        },
        "nota": { "type": "string" },
        "fuente": { "type": "string" },
        "prestadoresIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["nombre", "categoria"]
    },
    "Prestador": {
      "title": "Prestador",
      "description": "Información sobre un prestador de servicios médicos.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string" },
        "especialidades": {
          "type": "array",
          "items": { "type": "string" }
        },
        "direccion": { "type": "string" },
        "localidad": { "type": "string" },
        "telefono": { "type": "string" },
        "whatsapp": { "type": "string" },
        "email": { "type": "string" },
        "notas": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["nombre"]
    },
    "Folleto": {
      "title": "Folleto",
      "description": "Folleto informativo con enlace a Drive.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string" },
        "url": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nombre", "url"]
    },
    "PracticaOME": {
      "title": "Práctica OME",
      "description": "Información sobre una práctica OME.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "codigo": { "type": "string" },
        "descripcion": { "type": "string" },
        "descImpresa": { "type": "string" },
        "sinonimo": { "type": "string" },
        "modulo": { "type": "string" },
        "responsable": { "type": "string", "enum": ["Médico de Cabecera", "Médico Auditor"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["codigo", "descripcion", "modulo", "responsable"]
    },
    "CentroCoordinador": {
      "title": "Centro Coordinador",
      "description": "Información sobre centros coordinadores y sus trabajadores.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "hospital": { "type": "string" },
        "trabajador": { "type": "string" },
        "telefono": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["hospital", "trabajador", "telefono"]
    },
    "TelefonoInterno": {
      "title": "Teléfono Interno",
      "description": "Información sobre teléfonos internos y áreas de la agencia.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "area": { "type": "string" },
        "nombre": { "type": "string" },
        "interno": { "type": "string" },
        "nroInventario": { "type": "string" },
        "descripcionBien": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["area", "nombre", "interno"]
    }
  },
  "firestore": {
    "/tramites/{tramiteId}": {
      "schema": "Tramite",
      "description": "Colección de trámites de PAMI."
    },
    "/prestadores/{prestadorId}": {
      "schema": "Prestador",
      "description": "Colección de prestadores médicos."
    },
    "/folletos/{folletoId}": {
      "schema": "Folleto",
      "description": "Colección de folletos informativos."
    },
    "/practicas/{practicaId}": {
      "schema": "PracticaOME",
      "description": "Colección de prácticas OME."
    },
    "/centros_coordinadores/{centroId}": {
      "schema": "CentroCoordinador",
      "description": "Colección de centros coordinadores."
    },
    "/telefonos/{telefonoId}": {
      "schema": "TelefonoInterno",
      "description": "Colección de teléfonos internos."
    }
  }
}
