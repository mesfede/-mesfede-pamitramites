rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: tramites
    // Fields:
    //   - nombre: string (required)
    //   - categoria: string (required)
    //   - descripcion: string (optional)
    //   - pasos: list (optional)
    //   - nota: string (optional)
    //   - documentos: list (optional)
    //   - prestadoresIds: list (optional)
    //   - createdAt: timestamp
    //   - updatedAt: timestamp
    //   - createdBy: string (uid)
    //
    // Collection: prestadores
    // Fields:
    //   - nombre: string (required)
    //   - especialidades: list (unified with practices)
    //   - direccion: string (optional)
    //   - localidad: string (optional)
    //   - telefono: string (optional)
    //   - whatsapp: string (optional)
    //   - email: string (optional)
    //   - notas: string (optional)
    //   - createdBy: string (uid)
    //   - createdAt: timestamp
    //   - updatedAt: timestamp
    //
    // Collection: folletos
    // Fields:
    //   - nombre: string (required)
    //   - url: string (required)
    //   - createdAt: timestamp
    //
    // Collection: practicas
    // Fields:
    //   - codigo: string (required)
    //   - descripcion: string (required)
    //   - modulo: string (required)
    //   - responsable: string (required)
    //   - sinonimo: string (optional)
    //   - descImpresa: string (optional)
    //   - createdAt: timestamp
    //   - updatedAt: timestamp
    //
    // Collection: centros_coordinadores
    // Fields:
    //   - hospital: string (required)
    //   - trabajador: string (required)
    //   - telefono: string (required)
    //   - createdAt: timestamp
    //   - updatedAt: timestamp
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email in ["mesfede@gmail.com", "lizasomariajose@gmail.com"]) &&
        request.auth.token.email_verified == true;
    }

    function isValidTramite(data) {
      return data.nombre is string && data.nombre.size() > 0 && data.nombre.size() < 200 &&
             data.categoria is string && data.categoria.size() > 0 &&
             (!('descripcion' in data) || (data.descripcion is string && data.descripcion.size() < 5000)) &&
             (!('nota' in data) || (data.nota is string && data.nota.size() < 1000)) &&
             (!('pasos' in data) || (data.pasos is list && data.pasos.size() < 50)) &&
             (!('documentos' in data) || (data.documentos is list && data.documentos.size() < 20)) &&
             (!('prestadoresIds' in data) || (data.prestadoresIds is list && data.prestadoresIds.size() < 100));
    }

    function isValidFolleto(data) {
      return data.nombre is string && data.nombre.size() > 0 && data.nombre.size() < 200 &&
             data.url is string && data.url.size() > 0 && data.url.size() < 1000;
    }

    match /folletos/{folletoId} {
      allow read: if true;
      allow create: if isAdmin() && isValidFolleto(request.resource.data);
      allow update: if isAdmin() && isValidFolleto(request.resource.data);
      allow delete: if isAdmin();
    }

    match /tramites/{tramiteId} {
      allow read: if true; // Publicly readable
      allow create: if isAdmin() && isValidTramite(request.resource.data) && 
                      (request.resource.data.createdBy == request.auth.uid);
      allow update: if isAdmin() && isValidTramite(request.resource.data) &&
                      (request.resource.data.createdBy == resource.data.createdBy);
      allow delete: if isAdmin();
    }

    function isValidPrestador(data) {
      return data.nombre is string && data.nombre.size() > 0 && data.nombre.size() < 200 &&
             (!('especialidades' in data) || (data.especialidades is list && data.especialidades.size() < 50));
    }

    function isValidPractica(data) {
      return data.codigo is string && data.codigo.size() > 0 && data.codigo.size() < 50 &&
             data.descripcion is string && data.descripcion.size() > 0 && data.descripcion.size() < 1000 &&
             data.modulo is string && data.modulo.size() > 0 &&
             data.responsable in ['Médico de Cabecera', 'Médico Auditor'] &&
             (!('sinonimo' in data) || (data.sinonimo is string && data.sinonimo.size() < 1000)) &&
             (!('descImpresa' in data) || (data.descImpresa is string && data.descImpresa.size() < 1000));
    }

    function isValidCentro(data) {
      return data.hospital is string && data.hospital.size() > 0 && data.hospital.size() < 200 &&
             data.trabajador is string && data.trabajador.size() > 0 && data.trabajador.size() < 200 &&
             data.telefono is string && data.telefono.size() > 0 && data.telefono.size() < 50;
    }

    match /prestadores/{prestadorId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    match /practicas/{practicaId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidPractica(request.resource.data);
      allow update: if isAuthenticated() && isValidPractica(request.resource.data);
      allow delete: if isAuthenticated();
    }

    match /centros_coordinadores/{centroId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidCentro(request.resource.data);
      allow update: if isAuthenticated() && isValidCentro(request.resource.data);
      allow delete: if isAuthenticated();
    }
  }
}
