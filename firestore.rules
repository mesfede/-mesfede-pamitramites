rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: tramites
    // Fields:
    //   - nombre: string (required)
    //   - categoria: string (required)
    //   - descripcion: string (optional)
    //   - pasos: list (optional)
    //   - nota: string (optional)
    //   - documentos: list (optional)
    //   - prestadoresIds: list (optional)
    //   - createdAt: timestamp
    //   - updatedAt: timestamp
    //   - createdBy: string (uid)
    //
    // Collection: prestadores
    // Fields:
    //   - nombre: string (required)
    //   - especialidades: list (unified with practices)
    //   - direccion: string (optional)
    //   - localidad: string (optional)
    //   - telefono: string (optional)
    //   - whatsapp: string (optional)
    //   - email: string (optional)
    //   - notas: string (optional)
    //   - createdBy: string (uid)
    //   - createdAt: timestamp
    //   - updatedAt: timestamp
    //
    // Collection: folletos
    // Fields:
    //   - nombre: string (required)
    //   - url: string (required)
    //   - createdAt: timestamp
    //
    // Collection: practicas
    // Fields:
    //   - codigo: string (required)
    //   - descripcion: string (required)
    //   - modulo: string (required)
    //   - responsable: string (required)
    //   - sinonimo: string (optional)
    //   - descImpresa: string (optional)
    //   - createdAt: timestamp
    //   - updatedAt: timestamp
    //
    // Collection: centros_coordinadores
    // Fields:
    //   - hospital: string (required)
    //   - trabajador: string (required)
    //   - telefono: string (required)
    //   - createdAt: timestamp
    //   - updatedAt: timestamp
    //
    // Collection: telefonos
    // Fields:
    //   - area: string (required)
    //   - nombre: string (required)
    //   - interno: string (required)
    //   - nroInventario: string (optional)
    //   - descripcionBien: string (optional)
    //   - createdAt: timestamp
    //   - updatedAt: timestamp
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (
          request.auth.token.email.matches("(?i)^(mesfede@gmail\\.com|lizasomariajose@gmail\\.com)$") ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
        );
    }

    function isViewer() {
      return isAuthenticated() && 
        (
          isAdmin() || 
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "viewer")
        );
    }

    function isValidTramite(data) {
      return data.nombre is string && data.nombre.size() > 0 && data.nombre.size() < 200 &&
             data.categoria is string && data.categoria.size() > 0 &&
             (!('descripcion' in data) || (data.descripcion is string && data.descripcion.size() < 5000)) &&
             (!('nota' in data) || (data.nota is string && data.nota.size() < 1000)) &&
             (!('pasos' in data) || (data.pasos is list && data.pasos.size() < 50)) &&
             (!('documentos' in data) || (data.documentos is list && data.documentos.size() < 20)) &&
             (!('prestadoresIds' in data) || (data.prestadoresIds is list && data.prestadoresIds.size() < 100));
    }

    function isValidFolleto(data) {
      return data.nombre is string && data.nombre.size() > 0 && data.nombre.size() < 200 &&
             data.url is string && data.url.size() > 0 && data.url.size() < 1000;
    }

    function isValidPrestador(data) {
      return data.nombre is string && data.nombre.size() > 0 && data.nombre.size() < 200 &&
             (!('especialidades' in data) || (data.especialidades is list && data.especialidades.size() < 50));
    }

    function isValidPractica(data) {
      return data.codigo is string && data.codigo.size() > 0 && data.codigo.size() < 50 &&
             data.descripcion is string && data.descripcion.size() > 0 && data.descripcion.size() < 1000 &&
             data.modulo is string && data.modulo.size() > 0 &&
             data.responsable in ['Médico de Cabecera', 'Médico Auditor'] &&
             (!('sinonimo' in data) || (data.sinonimo is string && data.sinonimo.size() < 1000)) &&
             (!('descImpresa' in data) || (data.descImpresa is string && data.descImpresa.size() < 1000));
    }

    function isValidCentro(data) {
      return data.hospital is string && data.hospital.size() > 0 && data.hospital.size() < 200 &&
             data.trabajador is string && data.trabajador.size() > 0 && data.trabajador.size() < 200 &&
             data.telefono is string && data.telefono.size() > 0 && data.telefono.size() < 50 &&
             (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidTelefono(data) {
      return data.area is string && data.area.size() > 0 && data.area.size() < 200 &&
             data.nombre is string && data.nombre.size() > 0 && data.nombre.size() < 200 &&
             data.interno is string && data.interno.size() > 0 && data.interno.size() < 50 &&
             (!('nroInventario' in data) || (data.nroInventario is string && data.nroInventario.size() < 100)) &&
             (!('descripcionBien' in data) || (data.descripcionBien is string && data.descripcionBien.size() < 500)) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /folletos/{folletoId} {
      allow read: if isViewer();
      allow create: if isAdmin() && isValidFolleto(request.resource.data);
      allow update: if isAdmin() && isValidFolleto(request.resource.data);
      allow delete: if isAdmin();
    }

    match /tramites/{tramiteId} {
      allow read: if isViewer();
      allow create: if isAdmin() && isValidTramite(request.resource.data) && 
                      (request.resource.data.createdBy == request.auth.uid);
      allow update: if isAdmin() && isValidTramite(request.resource.data) &&
                      (request.resource.data.createdBy == resource.data.createdBy);
      allow delete: if isAdmin();
    }

    match /prestadores/{prestadorId} {
      allow read: if isViewer();
      allow create: if isAdmin() && isValidPrestador(request.resource.data);
      allow update: if isAdmin() && isValidPrestador(request.resource.data);
      allow delete: if isAdmin();
    }

    match /practicas/{practicaId} {
      allow read: if isViewer();
      allow create: if isAdmin() && isValidPractica(request.resource.data);
      allow update: if isAdmin() && isValidPractica(request.resource.data);
      allow delete: if isAdmin();
    }

    match /centros_coordinadores/{centroId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() && isValidCentro(request.resource.data);
      allow update: if isAdmin() && isValidCentro(request.resource.data);
      allow delete: if isAdmin();
    }

    match /telefonos/{telefonoId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() && isValidTelefono(request.resource.data);
      allow update: if isAdmin() && isValidTelefono(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
